{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "Business Source License 1.1",
  "scripts": {
    "prebuild": "npm install -g @nestjs/cli",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "migrate:create": "npx db-migrate create $npm_config_name --sql-file",
    "migrate:up": "npx db-migrate up",
    "migrate:down": "npx db-migrate down -c",
    "migrate:clean": "npx db-migrate down -c 100",
    "migrate:reset": "npm run migrate:clean && npm run migrate:up",
    "migrate:status": "npx db-migrate status",
    "db:drop-all": "psql $DATABASE_URL -f src/db/drop-table.sql",
    "db:create-all": "psql $DATABASE_URL -f src/db/create-table.sql"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^7.4.2",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.3",
    "ai": "^5.0.76",
    "axios": "^1.7.7",
    "cache-manager": "^6.4.0",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "pg": "^8.13.0",
    "postgres": "^3.4.4",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "swagger-ui-express": "^5.0.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@netlify/functions": "^2.8.2",
    "@types/express": "^4.17.21",
    "@types/jest": "29.2.4",
    "@types/multer": "^1.4.12",
    "@types/node": "18.11.18",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "db-migrate": "^0.11.13",
    "db-migrate-pg": "^1.2.2",
    "drizzle-kit": "^0.24.2",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "serverless-http": "^3.2.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^5.6.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}